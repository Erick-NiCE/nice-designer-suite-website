{
  "name": "lynn-ui",
  "version": "0.1.0",
  "description": "React components for Lynn - the NiCE Designer Suite's own dark, gradient- and motion-driven design system.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/lynn-ui.css": "./dist/lynn-ui.css",
    "./styles.css": "./dist/lynn-ui.css"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@types/react": "^18.3.12",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.7",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
